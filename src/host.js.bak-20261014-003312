import { randomUUID } from 'node:crypto';
import { createUserMessage } from '@deepseek-ai/dsh-llm';
import { Session, SessionId } from '@deepseek-ai/dsh-session';

export class DshHost {
  constructor(ctx, config) {
    const probe = Session.create(SessionId(`messenger-patch-probe-${randomUUID()}`));
    if (probe.append('messenger/probe', {}, { ignorable: true }).ignorable !== true) {
      throw new Error('dsh-messenger requires the ignorable-event Session patch');
    }
    this.ctx = ctx;
    this.config = config;
    this.owned = new Map();
    this.loading = new Map();
    this.cache = new Map();
    ctx.on('session/event', (session, event) => {
      const cached = this.cache.get(session.id);
      if (!cached) return;
      if (event.seq !== cached.count) { this.cache.delete(session.id); return; }
      cached.count++;
      cached.lastActivityAt = new Date(event.time).toISOString();
      const projected = this.project(event);
      if (projected) cached.events.push(projected);
    });
  }

  report(error) { this.ctx.logger.warn(`dsh-messenger: ${String(error)}`); }

  project(event) {
    if (event.type.startsWith('messenger/') || event.type === 'agent-preset/selected' || event.type === 'session/title') return event;
    if (event.type === 'request/header') return { ...event, data: { header: { config: event.data.header.config } } };
    if (event.type === 'user/message' && event.data.source?.kind === 'dsh-messenger') return event;
    if (event.type === 'agent/inbox/spliced') {
      return { ...event, data: { inserted: event.data.inserted.filter(message => message.source?.kind === 'dsh-messenger') } };
    }
  }

  async read(id) {
    const sessionId = SessionId(id);
    const live = this.ctx.sessions.get(sessionId);
    if (live) {
      const flushed = await this.ctx.sessions.flush(live);
      if (!flushed) throw new Error(`Session ${id} has no persistence writer`);
    }
    const revision = (await this.ctx.sessionPersistence.stat(sessionId))?.revision;
    let cached = this.cache.get(id);
    if (cached && ((live && cached.count === live.seq) || (!live && cached.revision === revision))) {
      cached.revision = revision;
      return { header: cached.header, events: [...cached.events], lastActivityAt: cached.lastActivityAt };
    }
    const log = await this.inspect(id);
    cached = {
      header: log.header, count: log.events.length, revision,
      lastActivityAt: new Date(log.events.at(-1)?.time ?? log.header.createdAt).toISOString(),
      events: log.events.map(event => this.project(event)).filter(Boolean),
    };
    this.cache.set(id, cached);
    return { header: cached.header, events: [...cached.events], lastActivityAt: cached.lastActivityAt };
  }

  async inspect(id) {
    const sessionId = SessionId(id);
    const live = this.ctx.sessions.get(sessionId);
    if (live) {
      const flushed = await this.ctx.sessions.flush(live);
      if (!flushed) throw new Error(`Session ${id} has no persistence writer`);
    }
    const handle = await this.ctx.sessionPersistence.open(sessionId, 'read');
    try {
      const result = await handle.read();
      return { header: handle.header, events: result.events };
    } finally { await handle.close(); }
  }

  recordedPreset(log) {
    const selected = [...log.events].reverse().find(event => event.type === 'agent-preset/selected');
    return selected?.data.agentPreset ?? log.header.agentPreset;
  }

  describe(header, recordedPreset, log) {
    const agent = this.ctx.agents.get(header.id);
    const presets = this.ctx.get('agentPresets');
    const preset = (agent && presets?.composedPreset(agent.ctx)) || recordedPreset || header.agentPreset;
    return {
      id: header.id, ...(preset ? { preset } : {}),
      status: agent?.status ?? 'inactive',
      title: log?.events.findLast(event => event.type === 'session/title')?.data.title ?? '',
      lastActivityAt: log?.lastActivityAt ?? new Date(header.createdAt).toISOString(),
      ...(header.cwd ? { cwd: header.cwd } : {}),
    };
  }

  async catalog() {
    const headers = new Map((await this.ctx.sessionPersistence.list()).map(row => [row.header.id, row.header]));
    for (const session of this.ctx.sessions.list()) headers.set(session.id, session.header);
    return Promise.all([...headers.values()].map(async header => {
      const log = await this.read(header.id);
      return this.describe(header, this.recordedPreset(log), log);
    }));
  }

  async peer(id) {
    const log = await this.read(id);
    return this.describe(log.header, this.recordedPreset(log), log);
  }

  async presets() {
    const presets = this.ctx.get('agentPresets');
    return presets ? presets.list() : [];
  }

  async mount(agentCtx, preset) {
    if (!preset) return;
    const presets = this.ctx.get('agentPresets');
    if (!presets) throw new Error(`Cannot compose preset ${preset}: agentPresets service absent`);
    await presets.mount(agentCtx, preset);
  }

  async ensure(id) {
    const live = this.ctx.agents.get(SessionId(id));
    if (live) return live;
    if (this.loading.has(id)) return this.loading.get(id);
    const task = (async () => {
      const log = await this.read(id);
      const preset = this.recordedPreset(log);
      const profile = this.config.peers[preset];
      // Resume must retain identity and composition, rather than accidentally
      // launching a blank/default-prompt agent. Require an explicit peer profile.
      if (!profile) throw new Error(`No resume profile configured for preset ${preset ?? '(none)'}`);
      const latest = [...log.events].reverse().find(event => event.type === 'request/header');
      const route = latest?.data.header.config ?? profile.agentOptions;
      const handle = await this.ctx.agents.resume({
        resumeSessionId: SessionId(id), agentOptions: route,
        setup: agentCtx => this.mount(agentCtx, preset),
      });
      this.owned.set(id, handle);
      return handle.agent;
    })();
    this.loading.set(id, task);
    try { return await task; }
    finally { this.loading.delete(id); }
  }

  async create(preset, title) {
    const profile = this.config.peers[preset];
    if (!profile) throw new Error(`Peer preset is not configured: ${preset}`);
    const titles = title === undefined ? undefined : this.ctx.get('sessionTitle');
    if (title !== undefined && !titles) throw new Error('Session title service is required to name a new peer session');
    const id = SessionId(randomUUID());
    const handle = await this.ctx.agents.create({
      sessionId: id, agentOptions: profile.agentOptions,
      meta: { agentPreset: preset, ...(profile.cwd ? { cwd: profile.cwd } : {}) },
      // No parentAgent: this is an independent root, not a subagent.
      setup: agentCtx => this.mount(agentCtx, preset),
    });
    this.owned.set(id, handle);
    if (title !== undefined) {
      titles.rename(handle.agent.session, title);
      if (!await this.ctx.sessions.flush(handle.agent.session)) throw new Error('Session title requires a persistence writer');
    }
    return this.peer(id);
  }

  async append(id, type, data) {
    const agent = await this.ensure(id);
    const event = agent.session.append(type, data, { ignorable: true });
    if (event.ignorable !== true) throw new Error('dsh-messenger requires the ignorable-event Session patch');
    const flushed = await this.ctx.sessions.flush(agent.session);
    if (!flushed) throw new Error('Messenger events require a persistence writer');
    return event;
  }

  async steer(id, message) {
    const agent = await this.ensure(id);
    const native = createUserMessage({
      content: [{ type: 'text', text: `[Channel ${message.channelId}; from ${message.senderSessionId}; ${message.sentAt}]\n${message.text}` }],
      source: {
        kind: 'dsh-messenger', channelId: message.channelId, messageId: message.messageId,
        senderSessionId: message.senderSessionId, sentAt: message.sentAt,
      },
    });
    // Keep native identity stable across retry/restart; the native source and
    // content are created through the standard user-message constructor.
    agent.steer(Object.freeze({ ...native, id: message.messageId }));
    await this.ctx.sessions.flush(agent.session);
  }

  async markRead(request) {
    if (!request.sessionId) return;
    const inputs = request.messages.filter(message => message.source?.kind === 'dsh-messenger');
    if (!inputs.length) return;
    const log = await this.read(request.sessionId);
    for (const message of inputs) {
      if (log.events.some(event => event.type === 'messenger/message_read' && event.data.messageId === message.source.messageId)) continue;
      await this.append(request.sessionId, 'messenger/message_read', {
        version: 1, channelId: message.source.channelId, messageId: message.source.messageId,
        recipientSessionId: request.sessionId, readAt: new Date().toISOString(),
      });
    }
  }

  async close() {
    await Promise.allSettled(this.loading.values());
    for (const handle of this.owned.values()) await handle.dispose();
    this.owned.clear();
    this.cache.clear();
  }
}
