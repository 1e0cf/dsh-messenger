{
  "name": "dsh-messenger",
  "version": "0.1.0",
  "description": "Session-backed channels between independent DeepSeek Harness agents",
  "type": "module",
  "main": "./lib/index.js",
  "exports": {
    ".": {
      "default": "./lib/index.js"
    }
  },
  "license": "MIT",
  "scripts": {
    "build": "bun build src/index.ts --outdir lib --target node --format esm --packages external",
    "test": "bun test",
    "typecheck": "bun check --no-script",
    "format": "bun fmt .",
    "lint": "bun lint",
    "gate": "bun fmt --check . && bun lint && bun check --no-script && bun test",
    "fix": "bun fmt . && bun lint --fix",
    "smoke": "bun scripts/restart-smoke.ts"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "~4.0.5",
    "@deepseek-ai/schemastery": "~3.18.5",
    "@deepseek-ai/dsh-session": "^0.2.1-rc.2",
    "@deepseek-ai/dsh-llm": "^0.2.1-rc.2",
    "@deepseek-ai/dsh-tools": "^0.2.1-rc.2"
  },
  "devDependencies": {
    "@types/node": "^26.6.5"
  },
  "files": [
    "lib",
    "README.md",
    "LICENSE"
  ]
}
